# InfiNet Services - .htaccess Configuration
# Global site config
RewriteEngine On
RewriteBase /

# www -> non-www (and force HTTPS in target)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect double-slash URLs to single slash (GSC "Crawled - currently not indexed")
RewriteRule ^//(.*)$ /$1 [R=301,L]

# Force HTTPS (fallback)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- SEO regression fix (2026-04-22): serve empty stub for missing Elementor JS bundles ---
# Elementor-Pro / Elementor hashed .bundle.min.js files are referenced by the static WP
# export but were not exported to disk. We serve an empty stub (HTTP 200) to prevent ~289/day
# Googlebot 404s from tanking crawl quality signal.
RewriteCond %{REQUEST_URI} ^/wp-content/plugins/elementor(-pro)?/assets/js/.+\.bundle\.min\.js$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /empty-elementor-stub.js [L]

# GSC 404 fixes: redirect old/malformed URLs to correct pages
RewriteRule ^home/contact/?$ /contact/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/privacy-policy [NC]
RewriteRule ^ /privacy/ [R=301,L]
RewriteRule ^services/contact/?$ /contact/ [R=301,L]
RewriteRule ^index\.html/contact/?$ /contact/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/index\.html%3Fp=\d+\.tmp\.html [NC]
RewriteRule ^ / [R=301,L]

# --- SEO regression fix (2026-04-22): legacy WP URLs still in Google's index ---
# /about (and /about/) confirmed in Apache logs as a live user-click 404 from google.com
RewriteRule ^about/?$ /about-us/ [R=301,L]

# /path/index.html -> /path/ (and /index.html -> /)
RewriteRule ^(.*/)index\.html$ $1 [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]

# No trailing slash -> add trailing slash (skip files with extension)
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,}$ [NC]
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Note: API reverse proxying is handled in the Apache VirtualHost (not here).
